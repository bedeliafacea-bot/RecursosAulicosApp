# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for admin user management on server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Drive OAuth (configurar el URI de redirección también en Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/drive/callback
# Generar una clave aleatoria de 32 bytes y guardarla como Base64
GOOGLE_TOKEN_ENCRYPTION_KEY=
